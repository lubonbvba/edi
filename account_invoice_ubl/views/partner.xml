<openerp>
<data>


<record id="partner_peppol_form" model="ir.ui.view">
    <field name="name">account_invoice_ubl.partner.peppol.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base_vat.view_partner_form"/>
    <field name="arch" type="xml">
        <div name="vat_info" position="after">
                            <label for="peppol_registered"/>

                    <div name="vat_info">
                        <field name="peppol_registered"  class="oe_inline" attrs="{'readonly': True}"/>
